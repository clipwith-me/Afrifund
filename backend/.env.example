# ==============================================================================
# AfriFund Backend Environment Configuration
# ==============================================================================

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# DATABASE
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/afrifund?schema=public

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================================================
# REDIS (Optional - for caching and sessions)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# RATE LIMITING
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ==============================================================================
# PAYMENT PROVIDERS
# ==============================================================================
# Leave payment provider credentials empty to use the Mock provider for testing
# The Mock provider works out of the box without any configuration

# ------------------------------------------------------------------------------
# Flutterwave (Pan-African, 150+ currencies)
# ------------------------------------------------------------------------------
# Sign up: https://dashboard.flutterwave.com/signup
# Documentation: https://developer.flutterwave.com/docs
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/payment/callback

# Test credentials (Sandbox) - Uncomment to test with Flutterwave sandbox:
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
# FLUTTERWAVE_WEBHOOK_SECRET=your_webhook_secret_hash
# Test cards: https://developer.flutterwave.com/docs/integration-guides/testing-helpers/

# ------------------------------------------------------------------------------
# Paystack (West Africa: Nigeria, Ghana, South Africa)
# ------------------------------------------------------------------------------
# Sign up: https://dashboard.paystack.com/signup
# Documentation: https://paystack.com/docs
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# Test credentials - Uncomment to test with Paystack sandbox:
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Test card (success): 4084084084084081, any CVV, future expiry
# Test card (decline): 4084080000000409

# ------------------------------------------------------------------------------
# M-Pesa (East Africa: Kenya, Tanzania)
# ------------------------------------------------------------------------------
# Apply: https://developer.safaricom.co.ke/
# Documentation: https://developer.safaricom.co.ke/docs
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/webhook/mpesa

# Sandbox testing - Uncomment to test with M-Pesa sandbox:
# MPESA_CONSUMER_KEY=your_consumer_key
# MPESA_CONSUMER_SECRET=your_consumer_secret
# MPESA_PASSKEY=your_passkey
# MPESA_SHORTCODE=174379
# MPESA_ENVIRONMENT=sandbox
# Test phone: 254708374149

# ==============================================================================
# PLATFORM CONFIGURATION
# ==============================================================================
PLATFORM_FEE_PERCENTAGE=3.0

# ==============================================================================
# FILE STORAGE
# ==============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
CERTIFICATE_STORAGE_PATH=./public/certificates

# ==============================================================================
# EMAIL CONFIGURATION (Optional)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@afrifund.com
SMTP_FROM_NAME=AfriFund

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================
MOCK_KYC_AUTO_APPROVE=true

# ==============================================================================
# PRODUCTION CHECKLIST
# ==============================================================================
# Before deploying to production:
# 1. ✓ Set strong JWT_SECRET and JWT_REFRESH_SECRET (min 32 random characters)
# 2. ✓ Set NODE_ENV=production
# 3. ✓ Configure production DATABASE_URL
# 4. ✓ Set FRONTEND_URL to your production domain
# 5. ✓ Switch to production payment provider keys (pk_live_, sk_live_)
# 6. ✓ Update all callback URLs to production URLs (HTTPS required!)
# 7. ✓ Configure webhook URLs on payment provider dashboards
# 8. ✓ Configure SMTP for email notifications
# 9. ✓ Set MOCK_KYC_AUTO_APPROVE=false for manual KYC review
# 10. ✓ Review and complete KYC verification with payment providers
# 11. ✓ Test webhook endpoints are publicly accessible (use ngrok for local testing)
# 12. ✓ Set up Redis for production caching
# 13. ✓ Configure proper file storage (AWS S3, Cloudinary, etc.)

# ==============================================================================
# NOTES
# ==============================================================================
# - When all payment provider credentials are empty, the Mock provider is used
# - Mock provider simulates payment flows without real transactions
# - For sandbox testing, uncomment and fill in the test credentials above
# - See PAYMENT_CONFIG.md for detailed setup instructions for each provider
